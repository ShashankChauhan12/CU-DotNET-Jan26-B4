@model List<Loan>

<h2>Loans List</h2>


<table class="table table-bordered mt-3">
    <thead>
        <tr>
            <th>Borrower</th>
            <th>Lender</th>
            <th>Amount</th>
            <th>Settled</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var loan in Model)
        {
            <tr>
                <td>@loan.BorrowerName</td>
                <td>@loan.LenderName</td>
                <td>@loan.Amount</td>
                <td>@loan.IsSettled</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@loan.Id" class="btn btn-warning" >Edit</a>
                    <a asp-action="Delete" asp-route-id="@loan.Id" class="btn btn-danger" onclick="return confirm('Are you sure you want to delete this record?');" >Delete</a>
                </td>

            </tr>
        }
    </tbody>
</table>
<a asp-action="Add" class="btn btn-primary">Add Loan</a>