@{
    ViewData["Title"] = "FinTrack Dashboard";
}

<div class="text-center">

    <h1 class="display-4">Welcome to FinTrack Pro</h1>

    <p class="lead">Manage your financial accounts, portfolio assets and market analysis.</p>

</div>

<hr />

<div class="row">

    <div class="col-md-4">
        <div class="card p-3">
            <h4>Accounts</h4>
            <p>Manage bank accounts.</p>
            <a href="/Accounts" class="btn btn-primary">Open Accounts</a>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card p-3">
            <h4>Portfolio</h4>
            <p>View your investment assets.</p>
            <a href="/Portfolio" class="btn btn-success">View Portfolio</a>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card p-3">
            <h4>Market Analysis</h4>
            <p>Analyze stock performance.</p>
            <a href="/Analyze/TSLA" class="btn btn-warning">Analyze Market</a>
        </div>
    </div>

</div>