@{
    ViewBag.Title = "Cart";
}

<h2>GlobalMart — My Cart</h2>

<table border="1" cellpadding="8">
    <thead>
        <tr>
            <th>Product</th>
            <th>Base Price</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in ViewBag.CartItems)
        {
            <tr>
                <td>@item["Name"]</td>
                <td>$@item["BasePrice"]</td>
            </tr>
        }
    </tbody>
</table>

<br />

<!-- Summary -->
<table border="1" cellpadding="8" style="width:300px;">
    <tr>
        <td>Subtotal</td>
        <td>$@ViewBag.Subtotal</td>
    </tr>
    <tr>
        <td>Promo Applied</td>
        <td>@(ViewBag.PromoCode != "" ? ViewBag.PromoCode : "None")</td>
    </tr>
    <tr>
        <td><strong>Grand Total</strong></td>
        <td><strong>$@ViewBag.GrandTotal</strong></td>
    </tr>
</table>

<br />
<a href="/Products">← Continue Shopping</a>